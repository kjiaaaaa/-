            'B4': '🎥 走廊监控\n20:25：林舒静离开。\n20:31：吕伟进入。\n20:39：吕伟离开。',
            'B5': '📝 证人记录\n有人看到李华在20:45左右进入旧教学楼附近。',
            'B6': '📄 死者的纸条\n"我已经知道钱是谁拿的。"\n"但我还不知道他为什么这么做。"'
        };

        var pages = {
            'page-home': document.getElementById('page-home'),
            'page-role': document.getElementById('page-role'),
            'page-studentid': document.getElementById('page-studentid'),
            'page-clue1': document.getElementById('page-clue1'),
            'page-lock': document.getElementById('page-lock'),
            'page-clue2': document.getElementById('page-clue2')
        };

        var sidebarLinks = document.querySelectorAll('.sidebar a');
        var menuToggle = document.getElementById('menuToggle');
        var sidebar = document.getElementById('sidebar');
        var currentRoleKey = null;

        function showPage(pageId) {
            var targetNav = document.querySelector(`.sidebar a[data-page="${pageId}"]`);
            if (targetNav && targetNav.classList.contains('locked')) {
                return;
            }

            for (var id in pages) {
                if (pages.hasOwnProperty(id)) {
                    pages[id].classList.add('hidden');
                }
            }
            pages[pageId].classList.remove('hidden');

            sidebarLinks.forEach(function(link) {
                if (link.getAttribute('data-page') === pageId) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });

            if (window.innerWidth <= 768) {
                sidebar.classList.remove('open');
            }
        }

        function unlockNav(navId) {
            var navElem = document.getElementById(navId);
            if (navElem) {
                navElem.classList.remove('locked');
            }
        }

        sidebarLinks.forEach(function(link) {
            link.addEventListener('click', function() {
                var targetPage = this.getAttribute('data-page');
                showPage(targetPage);
            });
        });

        document.getElementById('startBtn').addEventListener('click', function() {
            showPage('page-role');
        });

        document.getElementById('backBtn').addEventListener('click', function() {
            showPage('page-home');
        });

        menuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('open');
        });

        // 1. 确认角色：只确认匹配成功，不展示阵营与任何资料
        document.getElementById('confirmRoleBtn').addEventListener('click', function() {
            var inputName = document.getElementById('roleInput').value.trim();
            var errorDiv = document.getElementById('roleError');
            var identityDiv = document.getElementById('identityDisplay');
            var scriptPreview = document.getElementById('scriptPreview');

            if (roleData[inputName]) {
                currentRoleKey = inputName;

                errorDiv.textContent = '';
                identityDiv.innerHTML = '';

                scriptPreview.textContent =
                    '✅ 身份匹配成功。\n\n' +
                    '🔒 阵营与角色资料已完全锁定\n' +
                    '请前往「2. 你的学号」输入正确学号后查看阵营及完整角色资料。';

                // 解锁第2步与第一轮线索
                unlockNav('navStudentId');
                unlockNav('navClue1');

            } else {
                currentRoleKey = null;
                errorDiv.textContent = '未找到该角色，请检查输入名字是否正确。';
                identityDiv.innerHTML = '';
                scriptPreview.textContent = '等待确认角色身份...';
            }
        });

        // 2. 输入学号：显示阵营与完整剧本
        document.getElementById('confirmIdBtn').addEventListener('click', function() {
            var inputId = document.getElementById('studentIdInput').value.trim();
            var idError = document.getElementById('idError');
            var fullIdentityDiv = document.getElementById('fullIdentityDisplay');
            var scriptFull = document.getElementById('scriptFull');

            if (!currentRoleKey) {
                idError.textContent = '请先在第1步确认角色名字！';
                return;
            }

            var role = roleData[currentRoleKey];

            if (inputId === role.studentId) {
                idError.textContent = '';
                fullIdentityDiv.innerHTML = `<span class="identity-badge ${role.identityClass}">阵营：${role.identity}</span>`;
                scriptFull.textContent = role.script;
                unlockNav('navLock');
            } else {
                idError.textContent = '学号与当前角色不匹配，请重新输入！';
            }
        });

        // 3. 第一轮线索点击
        document.querySelectorAll('.hotspot').forEach(function(item) {
            item.addEventListener('click', function() {
                var clueKey = this.getAttribute('data-clue');
                var clueText = clueData[clueKey];
                if (clueText) {
                    document.getElementById('clue1Panel').innerHTML = `<strong>📌 线索 [${clueKey}]：</strong><br>${clueText.replace(/\n/g, '<br>')}`;
                    this.classList.add('revealed');
                }
            });
        });

        // 4. 第二轮密码
        document.getElementById('unlockBtn').addEventListener('click', function() {
            var pwd = document.getElementById('lockInput').value.trim();
            var lockError = document.getElementById('lockError');

            if (pwd === '0610') {
                lockError.style.color = '#2f855a';
                lockError.textContent = '密码正确！第二轮线索已解锁。';
                unlockNav('navClue2');
                setTimeout(function() {
                    showPage('page-clue2');
                }, 800);
            } else {
                lockError.style.color = '#e53e3e';
                lockError.textContent = '密码错误，请重新输入！';
            }
        });

        // 5. 第二轮线索点击
        document.querySelectorAll('.clue-btn').forEach(function(item) {
            item.addEventListener('click', function() {
                var clueKey = this.getAttribute('data-clue');
                var clueText = clueData[clueKey];
                if (clueText) {
                    document.getElementById('clue2Panel').innerHTML = `<strong>📌 线索 [${clueKey}]：</strong><br>${clueText.replace(/\n/g, '<br>')}`;
                    this.classList.add('revealed');
                }
            });
        });
    </script>
